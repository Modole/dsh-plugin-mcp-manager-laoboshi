{
  "name": "@laobos/dsh-mcp-manager",
  "version": "0.1.0",
  "description": "在 DSH Web 中管理 stdio 与 Streamable HTTP MCP Server。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "test": "node --test",
    "check:syntax": "node --check lib/index.js && node --check lib/client.js"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "laoboshi",
    "mcp-manager"
  ],
  "author": "Modole (laoboshi)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Modole/dsh-plugin-mcp-manager-laoboshi.git"
  },
  "bugs": {
    "url": "https://github.com/Modole/dsh-plugin-mcp-manager-laoboshi/issues"
  },
  "homepage": "https://github.com/Modole/dsh-plugin-mcp-manager-laoboshi#readme",
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-mcp-client": "0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.0-rc.6",
    "react": "^18.2.0 || ^19.0.0"
  }
}
